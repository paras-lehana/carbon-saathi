# ──────────────────────────────────────────────────────────────────────────────
# Carbon Saathi — environment contract (schema of record)
#
# Copy to `.env` (api) / `.env.local` (web) and fill what you have.
# EVERY integration degrades gracefully when its key is absent: the app boots,
# all pages render, and the affected feature switches to a clearly-labelled
# demo/fallback mode. See GOOGLE_SERVICES.md for the per-service contract.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
# Demo mode replaces all external Google calls with deterministic local
# fallbacks (useful for judges/offline demos). Resolution order:
#   DEMO_MODE=true  → always demo;  DEMO_MODE=false → always live;
#   unset           → auto: live when GEMINI_API_KEY is present, demo otherwise.
DEMO_MODE=
PORT=8080
NODE_ENV=development

# ── Google AI (Gemini) — Saathi Chat assistant ───────────────────────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Google Maps Platform — commute emission comparison ───────────────────────
# Server-side key (Distance Matrix / Geocoding). Restrict by IP in production.
GOOGLE_MAPS_API_KEY=
# Browser key (Maps JavaScript API, optional interactive map). Restrict by referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Firebase (Auth + Firestore persistence tier) ──────────────────────────────
# Without these the API uses an in-memory store (sessions reset on restart).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Analytics 4 (optional usage analytics) ─────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ── API hardening ─────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000
# Token-bucket rate limit applied to all /api routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Assistant calls are costlier — stricter dedicated bucket.
ASSISTANT_RATE_LIMIT_MAX=10
# Commute lookups can hit the billable Maps Distance Matrix API — same idea.
COMMUTE_RATE_LIMIT_MAX=10

# ── Web → API wiring ──────────────────────────────────────────────────────────
# The Next.js dev server proxies /api/* here (see apps/web/next.config.ts).
API_BASE_URL=http://localhost:8080
